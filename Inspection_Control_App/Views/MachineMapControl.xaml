<UserControl x:Class="Inspection_Control_App.Views.MachineMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Inspection_Control_App.Views"
             Focusable="True" FocusVisualStyle="{x:Null}">

    <UserControl.Resources>
        <!-- Nút ✕ xóa máy -->
        <ControlTemplate x:Key="DeleteButtonTemplate" TargetType="Button">
            <Border x:Name="Bg" Width="20" Height="20" CornerRadius="10" Background="#D9534F"
                    BorderBrush="#1E1E1E" BorderThickness="2">
                <TextBlock Text="✕" FontSize="9" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#FF6B66"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Giao diện 1 ô máy -->
        <DataTemplate x:Key="MachineTileTemplate">
            <Grid Margin="3">
                <Border x:Name="Card" CornerRadius="8" BorderThickness="1" BorderBrush="#3A3D44"
                        Padding="9,0,6,0" ToolTip="{Binding ToolTipText}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33363C" Offset="0"/>
                            <GradientStop Color="#26282D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <!-- Tên máy dùng hết chiều ngang -->
                        <TextBlock x:Name="TxtName" Text="{Binding MachineName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E8E8E8" TextTrimming="CharacterEllipsis"/>
                        <!-- Icon tablet + Bàn · số PO -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="IconGlyph" Text="&#xE70A;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="#4FC3F7" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtSub" Text="{Binding SubText}" FontSize="10.5" Foreground="#8A8F98"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nhãn "MÁY NÀY" -->
                <Border x:Name="BadgeCurrent" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="10,-7,0,0" Background="#007ACC" CornerRadius="3" Padding="5,1" IsHitTestVisible="False">
                    <TextBlock Text="MÁY NÀY" FontSize="8.5" FontWeight="Bold" Foreground="White"/>
                </Border>

                <!-- Nút xóa (chỉ khi đang chỉnh sửa) -->
                <Button x:Name="BtnDelete" Visibility="Collapsed" Template="{StaticResource DeleteButtonTemplate}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-5,0"
                        Cursor="Hand" ToolTip="Xóa máy" Click="BtnDelete_Click"/>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Máy giữ PO cùng type → sáng lên -->
                <DataTrigger Binding="{Binding IsMatched}" Value="True">
                    <Setter TargetName="Card" Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFE58A" Offset="0"/>
                                <GradientStop Color="#FFB547" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="Card" Property="BorderBrush" Value="#FFE082"/>
                    <Setter TargetName="Card" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFC107" BlurRadius="20" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="IconGlyph" Property="Foreground" Value="#5A3E00"/>
                    <Setter TargetName="TxtName" Property="Foreground" Value="#2B1D00"/>
                    <Setter TargetName="TxtSub" Property="Foreground" Value="#5A3E00"/>
                </DataTrigger>
                <!-- Máy đang chạy app -->
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#007ACC"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="BadgeCurrent" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- Đang chỉnh sửa → hiện nút xóa -->
                <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType=local:MachineMapControl}}" Value="True">
                    <Setter TargetName="BtnDelete" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="Frame" Background="#1E1E1E" CornerRadius="10" Padding="10" BorderBrush="#2D2D30" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề + chú thích -->
            <Grid Grid.Row="0" Margin="4,0,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtHeader" Text="🗺 SƠ ĐỒ MÁY (CÙNG TYPE)" FontSize="13" FontWeight="Bold"
                           Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,5,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFE58A" Offset="0"/>
                                <GradientStop Color="#FFB547" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="Giữ cùng type" FontSize="11" Foreground="#CCCCCC" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border Width="12" Height="12" CornerRadius="3" Background="Transparent" BorderBrush="#007ACC"
                            BorderThickness="2" Margin="0,0,5,0"/>
                    <TextBlock Text="Máy này" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Khung 6×4: ô trống, máy, chỉ báo ô đích dựng từ code -->
            <Grid Grid.Row="1" x:Name="MapGrid" Background="Transparent"/>

            <!-- Hướng dẫn khi chỉnh sửa -->
            <TextBlock Grid.Row="2" x:Name="TxtEditHint" Margin="4,8,4,0" FontSize="11" Foreground="#9CDCFE"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Text="✏ Kéo máy để đổi vị trí (thả lên máy khác để đổi chỗ) · Bấm máy để đổi mã · Bấm ô ＋ để thêm · ✕ để xóa · Esc để hủy kéo"/>

            <!-- Tóm tắt -->
            <TextBlock Grid.Row="3" x:Name="TxtSummary" Margin="4,6,4,0" FontSize="11" Foreground="#888888"
                       TextWrapping="Wrap" Text="Chưa có PO đang check."/>
        </Grid>
    </Border>
</UserControl>
