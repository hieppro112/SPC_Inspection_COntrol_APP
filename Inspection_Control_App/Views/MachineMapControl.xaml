<UserControl x:Class="Inspection_Control_App.Views.MachineMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Giao diện 1 ô máy -->
        <DataTemplate x:Key="MachineTileTemplate">
            <Border x:Name="Tile" Margin="4" Padding="8,4" Height="46" CornerRadius="6"
                    Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                    ToolTip="{Binding MatchInfo}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtName" Text="{Binding MachineName}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#9A9A9A" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtSub" Text="{Binding SubText}" FontSize="10" Foreground="#6E6E6E"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- Máy giữ PO cùng type → sáng lên -->
                <DataTrigger Binding="{Binding IsMatched}" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="#FFD54F"/>
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#FFE082"/>
                    <Setter TargetName="Tile" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFD54F" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="TxtName" Property="Foreground" Value="#1A1A1A"/>
                    <Setter TargetName="TxtSub" Property="Foreground" Value="#4A3B00"/>
                </DataTrigger>
                <!-- Máy đang chạy app → viền xanh -->
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="#007ACC"/>
                    <Setter TargetName="Tile" Property="BorderThickness" Value="2"/>
                </DataTrigger>            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="#1E1E1E" CornerRadius="8" Padding="10" BorderBrush="#2D2D30" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề + chú thích -->
            <Grid Grid.Row="0" Margin="4,0,4,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🗺 SƠ ĐỒ MÁY (CÙNG TYPE)" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="12" Height="12" CornerRadius="3" Background="#FFD54F" Margin="0,0,5,0"/>
                    <TextBlock Text="Giữ cùng type" FontSize="11" Foreground="#CCCCCC" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border Width="12" Height="12" CornerRadius="3" Background="Transparent" BorderBrush="#007ACC"
                            BorderThickness="2" Margin="0,0,5,0"/>
                    <TextBlock Text="Máy này" FontSize="11" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Lưới máy: hàng/cột dựng từ code theo RowNo/ColNo -->
            <Grid Grid.Row="1" x:Name="MapGrid"/>

            <!-- Tóm tắt -->
            <TextBlock Grid.Row="2" x:Name="TxtSummary" Margin="4,6,4,0" FontSize="11" Foreground="#888888"
                       TextWrapping="Wrap" Text="Chưa có PO đang check."/>

            <!-- Gợi ý sửa mã máy (chỉ hiện khi được phép sửa) -->
            <TextBlock Grid.Row="3" x:Name="TxtEditHint" Margin="4,4,4,0" FontSize="11" Foreground="#9CDCFE"
                       Visibility="Collapsed" Text="✏ Nhấn vào một máy để đổi mã máy."/>
        </Grid>
    </Border>
</UserControl>
