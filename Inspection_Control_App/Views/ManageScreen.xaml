<Window x:Class="Inspection_Control_App.Views.ManageScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:Inspection_Control_App.Views"
            mc:Ignorable="d"
        Icon="/Views/project-manager.ico"
             Background="#181818" Foreground="White" Height="561" Width="787" Title="Manager WIP"
             >

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Row 0: Header & Legend -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Khung nhập thông tin (2 Ô) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Bảng hiển thị DataGrid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 0. HEADER & CHÚ THÍCH ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tiêu đề bên trái -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="⚡ QUẢN LÝ BÀN CHECK (CHECK)" FontSize="15" FontWeight="Bold" Foreground="#007ACC"/>
                <TextBlock Text="Trạng thái làm việc và danh sách PO theo từng bàn" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Chú thích (Legend) bên phải -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Status: Đang check (Màu vàng) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Width="12" Height="12" CornerRadius="6" Background="#E2A03F" Margin="0,0,6,0"/>
                    <TextBlock Text="Đang check" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status: Rảnh / Bình thường (Màu xanh) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="12" Height="12" CornerRadius="6" Background="#5E5E5E" Margin="0,0,6,0"/>
                    <TextBlock Text="WIP" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= 1. KHUNG NHẬP THÔNG TIN (2 Ô INPUT) ================= -->
        <Border Grid.Row="1" Background="#252526" CornerRadius="6" Padding="14" Margin="0,0,0,16" BorderBrush="#3F3F46" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Ô nhập 1: Mã PO -->
                    <ColumnDefinition Width="*"/>
                    <!-- Ô nhập 2: Số bàn / Mã NV -->
                    <ColumnDefinition Width="*"/>
                    <!-- Ô nhập 3: thời gian-->
                    <ColumnDefinition Width="*"/>
                    <!-- Nút thao tác -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ô nhập 1 -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="MÃ PO / PO NUMBER" FontSize="11" FontWeight="SemiBold" Foreground="#9CDCFE" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtPONumber" Height="32" Background="#1E1E1E" Foreground="White" 
                             BorderBrush="#3F3F46" BorderThickness="1" Padding="8,5" VerticalContentAlignment="Center" FontSize="13"/>
                </StackPanel>

                <!-- Ô nhập 2 -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock x:Name="lbl_id_manager" Text="Mã Số Quản lý" FontSize="11" FontWeight="SemiBold" Foreground="#9CDCFE" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtID" Height="32" Background="#1E1E1E" Foreground="White" 
                             BorderBrush="#3F3F46" BorderThickness="1" Padding="8,5" VerticalContentAlignment="Center" FontSize="13" KeyDown="txtID_KeyDown"/>
                    <!-- Dòng thông báo lỗi (Ẩn mặc định) -->
                    <TextBlock x:Name="lblIDError" Text="⚠ Sai mã quản lý!" 
               FontSize="11" Foreground="#FF5555" Margin="2,4,0,0" 
               Visibility="Collapsed" FontWeight="SemiBold"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Margin="0,0,0,0">
                    <TextBlock  Text="Thời gian Fillter" FontSize="11" FontWeight="SemiBold" Foreground="#9CDCFE" Margin="0,0,0,6"/>
                    <!-- ComboBox lọc thời gian bên phải -->
                    <ComboBox  x:Name="cboFilterDate" Width="140" Height="28" 
                       SelectedIndex="1" FontSize="12" VerticalContentAlignment="Center"
                       Foreground="White" BorderBrush="#3F3F46"
                       SelectionChanged="cboFilterDate_SelectionChanged">

                        <!-- Override Template để ép màu nền #252526 tuyệt đối -->
                        <ComboBox.Template>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton" 
       Focusable="false" 
       IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
       ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Border" 
             Background="#252526" 
             BorderBrush="#3F3F46" 
             BorderThickness="1" 
             CornerRadius="4">
                                                    <Grid HorizontalAlignment="Right">
                                                        <Path x:Name="Arrow" 
                   Data="M 0 0 L 4 4 L 8 0 Z" 
                   Fill="#CCCCCC" 
                   Margin="0,0,8,0" 
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- Hiệu ứng Hover rê chuột -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#333337" />
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- Hiển thị Text đang chọn -->
                                    <ContentPresenter x:Name="ContentSite" 
           IsHitTestVisible="False" 
           Content="{TemplateBinding SelectionBoxItem}" 
           ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
           ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
           Margin="10,0,25,0" 
           VerticalAlignment="Center" 
           HorizontalAlignment="Left"/>

                                    <!-- Popup danh sách sổ xuống -->
                                    <Popup x:Name="Popup" 
Placement="Bottom" 
IsOpen="{TemplateBinding IsDropDownOpen}" 
AllowsTransparency="True" 
Focusable="False" 
PopupAnimation="Slide">
                                        <Grid x:Name="DropDown" 
   SnapsToDevicePixels="True" 
   MinWidth="{TemplateBinding ActualWidth}" 
   MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                            <Border x:Name="DropDownBorder" 
         Background="#252526" 
         BorderBrush="#3F3F46" 
         BorderThickness="1" 
         CornerRadius="4" 
         Margin="0,2,0,0"/>
                                            <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </ComboBox.Template>

                        <!-- Style màu cho các Item bên trong khi xổ danh sách -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#252526"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3E3E42"/>
                                        <Setter Property="Foreground" Value="#9CDCFE"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>

                        <!-- Các Item con -->
                        <ComboBoxItem Content="Hôm nay"/>
                        <ComboBoxItem Content="7 ngày trở lại"/>
                        <ComboBoxItem Content="30 ngày trở lại"/>
                    </ComboBox>
                </StackPanel>

                <!-- Nút bấm Tìm kiếm / Thêm mới -->
                <Button x:Name="btnSubmit" Grid.Column="3" Content="🔍 XÁC NHẬN" Height="32" Width="110" VerticalAlignment="Bottom"
                        Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="btnSubmit_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ================= 2. BẢNG HIỂN THỊ DATAGRID ================= -->
        <DataGrid Grid.Row="2" x:Name="dgCheckStatus" AutoGenerateColumns="False" CanUserAddRows="False" 
                  IsReadOnly="True" Background="#252526" RowBackground="#1E1E1E" AlternationCount="2"
AlternatingRowBackground="#252526"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46" HeadersVisibility="Column"
                  Foreground="White" FontSize="12" RowHeight="36">

            <!-- Style Header cho DataGrid -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Setter Property="Foreground" Value="#9CDCFE"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <!-- Cột 1: Số bàn (Index) - Badge Xanh Nổi bật -->
                <DataGridTemplateColumn Header="Số Bàn" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Index}" Foreground="#60A5FA" FontWeight="Bold" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột 2: Mã PO (PONumber) -->
                <DataGridTextColumn Header="Mã PO" Binding="{Binding PONumber}" Width="130" FontWeight="SemiBold"/>

                <!-- Cột 3: Loại PO (Typename / PSTX) -->
                <DataGridTextColumn Header="Loại PO" Binding="{Binding Typename}" Width="85"/>

                <!-- Cột 4: Tên RO (Roname) -->
                <DataGridTextColumn Header="Tên RO" Binding="{Binding Roname}" Width="*"/>

                <!-- Cột 5: Số Inspec (NumInspec) -->
                <DataGridTextColumn Header="Số Inspec" Binding="{Binding NumInspec}" Width="90" Foreground="#CE9178"/>

                <!-- Cột 6: Trạng thái (Status) - Dynamic Badge Colors -->
                <DataGridTemplateColumn Header="Trạng Thái" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#2D2D30"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Checking">
                                                <Setter Property="Background" Value="#E2A03F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Rảnh">
                                                <Setter Property="Background" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột 7: Thời Gian Lưu (SavedAt) -->
                <DataGridTextColumn Header="Thời Gian Lưu" Binding="{Binding SavedAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="130" Foreground="#888888"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>