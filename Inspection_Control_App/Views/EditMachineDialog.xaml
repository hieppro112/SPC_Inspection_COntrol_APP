<Window x:Class="Inspection_Control_App.Views.EditMachineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mã máy" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#181818" Foreground="White">

    <StackPanel Margin="18">
        <TextBlock Text="✏ ĐỔI MÃ MÁY" FontSize="15" FontWeight="Bold" Foreground="#007ACC"/>
        <TextBlock x:Name="TxtPosition" FontSize="11" Foreground="#888888" Margin="0,2,0,14"/>

        <TextBlock Text="Mã máy hiện tại" FontSize="11" FontWeight="SemiBold" Foreground="#9CDCFE" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtOld" IsReadOnly="True" Height="32" Background="#252526" Foreground="#AAAAAA"
                 BorderBrush="#3F3F46" Padding="8,5" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,0,12"/>

        <TextBlock Text="Mã máy mới" FontSize="11" FontWeight="SemiBold" Foreground="#9CDCFE" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtNew" Height="32" Background="#1E1E1E" Foreground="White" MaxLength="100"
                     BorderBrush="#3F3F46" Padding="8,5" VerticalContentAlignment="Center" FontSize="13"
                     KeyDown="TxtNew_KeyDown"/>
            <Button Grid.Column="1" x:Name="BtnUseThis" Content="Dùng máy này" Margin="8,0,0,0" Padding="10,0"
                    Background="#23272E" Foreground="White" BorderBrush="#3F3F46" Cursor="Hand"
                    Click="BtnUseThis_Click"/>
        </Grid>
        <TextBlock x:Name="TxtError" FontSize="11" Foreground="#FF5555" Visibility="Collapsed" TextWrapping="Wrap"
                   Margin="2,2,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Hủy" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"
                    Background="#23272E" Foreground="White" BorderBrush="#3F3F46" Cursor="Hand"/>
            <Button x:Name="BtnSave" Content="💾 Lưu" Width="90" Height="32"
                    Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
