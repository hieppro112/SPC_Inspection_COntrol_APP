<Window x:Class="Inspection_Control_App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PO &amp; Check Management Dashboard" 
        Height="850" Width="1450"
        Background="#181818" Foreground="White"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Modern ScrollViewer Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Input Control Base Styles -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Custom DataGrid Styling -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#2D2D30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2D2D30"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2D2E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Row -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦 PO TRACKING &amp; CHECK SYSTEM" FontSize="18" FontWeight="Bold" Foreground="#007ACC"/>
                    <TextBlock Text=" | Hệ thống giám sát PO &amp; Bàn Check" FontSize="13" Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📥 Import Data" Background="#0E639C" Foreground="White" BorderThickness="0" Padding="14,8" Margin="0,0,8,0" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button Content="📤 Export Excel" Background="#23272E" Foreground="White" BorderBrush="#3F3F46" BorderThickness="1" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="🔄 Refresh" Background="#23272E" Foreground="White" BorderBrush="#3F3F46" BorderThickness="1" Padding="14,8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Column: Input & List PO (Width 68%) -->
                <ColumnDefinition Width="2.2*"/>
                <!-- Splitter/Gap -->
                <ColumnDefinition Width="16"/>
                <!-- Right Column: Check Area (Width 32%) -->
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT PANEL (INPUT & LIST PO) ================= -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Input Controls -->
                    <RowDefinition Height="*"/>
                    <!-- Data Table -->
                </Grid.RowDefinitions>

                <!-- 1. INPUT & FILTER PANEL -->
                <Border Grid.Row="0" Background="#252526" CornerRadius="8" Padding="16" Margin="0,0,149,16">
                    <StackPanel>
                        <TextBlock Text="🔍 BỘ LỌC DỮ LIỆU (INPUT)" FontSize="14" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,12"/>

                        <UniformGrid Columns="3">
                            <!-- Field 1: Bàn Info -->
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Bàn Info:" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtInspectionPos" ToolTip="Mã bàn" IsEnabled="False"/>
                            </StackPanel>

                            <!-- Field 2: PO Stay Check -->
                            <StackPanel Margin="5,0,5,0">
                                <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4" Text="PO ĐANG CHECK"/>
                                <TextBox x:Name="txtPoStayCheck" ToolTip="Nhập mã PO cần kiểm tra..." TextChanged="txtPoStayCheck_TextChanged" IsEnabled="False"/>
                            </StackPanel>

                            <!-- Field 3: WiP Filter -->
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="WIP" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtInputWIP" ToolTip="Nhập mã PO cần kiểm tra..." KeyDown="txtInputWIP_KeyDown" TextChanged="txtInputWIP_TextChanged"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 2. LIST PO (DATAGRID) -->
                <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="12" BorderBrush="#2D2D30" BorderThickness="1" Margin="0,0,149,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📋 DANH SÁCH PO (LIST PO)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="4,4,0,12"/>

                        <!-- Bảng Dữ Liệu Chính -->
                        <DataGrid Grid.Row="1" x:Name="dgListPO" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="75"/>
                                <DataGridTextColumn Header="PO Number" Binding="{Binding PONumber}" Width="110"/>
                                <DataGridTextColumn Header="Lot" Binding="{Binding Lot}" Width="90"/>
                                <DataGridTextColumn Header="Ship To" Binding="{Binding ShipTo}" Width="100"/>
                                <DataGridTextColumn Header="Ship By" Binding="{Binding ShipBy}" Width="100"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="65"/>
                                <DataGridTextColumn Header="Export Date" Binding="{Binding ExportDate}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= RIGHT PANEL (CHECK AREA) ================= -->
            <Border Background="#252526" CornerRadius="8" Padding="16" Grid.ColumnSpan="3" Margin="811,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="⚡ QUẢN LÝ BÀN CHECK (CHECK)" FontSize="14" FontWeight="Bold" Foreground="#007ACC"/>
                        <TextBlock Text="Trạng thái làm việc theo từng bàn" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Bảng trạng thái Bàn Check -->
                    <DataGrid Grid.Row="1" x:Name="dgCheckStatus" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>

                            <!-- Cột 1: Mã PO -->
                            <DataGridTextColumn Header="Mã PO" Binding="{Binding PONumber}" Width="130"/>

                            <!-- Cột 2: Loại (PSTX / Typename) -->
                            <DataGridTextColumn Header="Loại PO" Binding="{Binding Typename}" Width="80"/>

                            <!-- Cột 3: Số lượng Inspec / Trạng thái WiP (Badge Màu) -->
                            <DataGridTemplateColumn Header="Số Inspec (WiP)" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#5E5E5E"/>
                                                    <Style.Triggers>
                                                        <!-- Thay đổi màu dựa vào thuộc tính NumInspec -->
                                                        <DataTrigger Binding="{Binding Status}" Value="Normal">
                                                            <Setter Property="Background" Value="#5E5E5E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Checking">
                                                            <Setter Property="Background" Value="#E2A03F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rảnh">
                                                            <Setter Property="Background" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <!-- Hiển thị nội dung NumInspec -->
                                            <TextBlock Text="{Binding NumInspec}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột 4: Thời gian Lưu -->
                            <DataGridTextColumn Header="Thời Gian Lưu" Binding="{Binding SavedAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" Background="#252526" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0"/>
                    <TextBlock Text="Hệ thống kết nối thành công" Foreground="#AAAAAA" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Tổng số PO: " Foreground="#AAAAAA" FontSize="12"/>
                    <TextBlock Text="128" Foreground="#007ACC" FontWeight="Bold" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock Text="Menu Options" Foreground="#888888" FontSize="12" TextDecorations="Underline" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>