<Window x:Class="Inspection_Control_App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PO &amp; Check Management Dashboard" 
        Height="850" Width="1450"
        Background="#181818" Foreground="White"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" WindowState="Normal" Icon="/checklist.ico">

    <Window.Resources>
        <!-- Modern ScrollViewer Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Input Control Base Styles -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Custom DataGrid Styling -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#2D2D30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2D2D30"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2D2E"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188*"/>
            <ColumnDefinition Width="663*"/>
            <ColumnDefinition Width="567*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Row -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" Grid.ColumnSpan="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦 PO TRACKING &amp; CHECK SYSTEM" FontSize="18" FontWeight="Bold" Foreground="#007ACC"/>
                    <TextBlock Text=" | Hệ thống giám sát PO &amp; Bàn Check" FontSize="13" Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btn_manage" Content="📥 Manage" Background="#0E639C" Foreground="White" BorderThickness="0" Padding="14,8" Margin="0,0,8,0" FontWeight="SemiBold" Cursor="Hand" Click="btn_manage_Click"/>
                    <Button Content="📤 Export Excel" Background="#23272E" Foreground="White" BorderBrush="#3F3F46" BorderThickness="1" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="🔄 Refresh" Background="#23272E" Foreground="White" BorderBrush="#3F3F46" BorderThickness="1" Padding="14,8" Cursor="Hand" Click="Button_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT ==================== -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
                <!-- Left Column: Input & List PO (Width 68%) -->
                <ColumnDefinition Width="235*"/>
                <!-- Splitter/Gap -->
                <ColumnDefinition Width="10"/>
                <!-- Right Column: Check Area (Width 32%) -->
                <ColumnDefinition Width="117*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT PANEL (INPUT & LIST PO) ================= -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Input Controls -->
                    <RowDefinition Height="*"/>
                    <!-- Data Table -->
                </Grid.RowDefinitions>

                <!-- 1. INPUT & FILTER PANEL -->
                <Border Grid.Row="0" Background="#252526" CornerRadius="8" Padding="16" Margin="0,0,105,16">
                    <StackPanel>
                        <TextBlock Text="🔍 BỘ LỌC DỮ LIỆU (INPUT)" FontSize="14" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,12"/>

                        <UniformGrid Columns="3">
                            <!-- Field 1: Bàn Info -->
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Bàn Info:" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtInspectionPos" ToolTip="Mã bàn" IsEnabled="False"/>
                            </StackPanel>

                            <!-- Field 2: PO Stay Check -->
                            <StackPanel Margin="5,0,5,0">
                                <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4" Text="PO ĐANG CHECK"/>
                                <TextBox x:Name="txtPoStayCheck" ToolTip="Nhập mã PO cần kiểm tra..."  IsEnabled="False"/>
                            </StackPanel>

                            <!-- Field 3: WiP Filter -->
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="WIP" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtInputWIP" ToolTip="Nhập mã PO cần kiểm tra..." />
                            </StackPanel>
                            <!-- Field 3: Thời gian Filter -->
                            <StackPanel Margin="10,20,0,10">
                                <TextBlock Text="Thời gian Fillter" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                                <!-- ComboBox lọc thời gian bên phải -->
                                <ComboBox  x:Name="cboFilterDate" Width="140" Height="28" 
                                    SelectedIndex="1" FontSize="12" VerticalContentAlignment="Center"
                                    Foreground="White" BorderBrush="#3F3F46"
                                    SelectionChanged="cboFilterDate_SelectionChanged">

                                    <!-- Override Template để ép màu nền #252526 tuyệt đối -->
                                    <ComboBox.Template>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid>
                                                <ToggleButton x:Name="ToggleButton" 
                    Focusable="false" 
                    IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                    ClickMode="Press">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="Border" 
                          Background="#252526" 
                          BorderBrush="#3F3F46" 
                          BorderThickness="1" 
                          CornerRadius="4">
                                                                <Grid HorizontalAlignment="Right">
                                                                    <Path x:Name="Arrow" 
                                Data="M 0 0 L 4 4 L 8 0 Z" 
                                Fill="#CCCCCC" 
                                Margin="0,0,8,0" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <!-- Hiệu ứng Hover rê chuột -->
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="#333337" />
                                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>

                                                <!-- Hiển thị Text đang chọn -->
                                                <ContentPresenter x:Name="ContentSite" 
                        IsHitTestVisible="False" 
                        Content="{TemplateBinding SelectionBoxItem}" 
                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                        Margin="10,0,25,0" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Left"/>

                                                <!-- Popup danh sách sổ xuống -->
                                                <Popup x:Name="Popup" 
             Placement="Bottom" 
             IsOpen="{TemplateBinding IsDropDownOpen}" 
             AllowsTransparency="True" 
             Focusable="False" 
             PopupAnimation="Slide">
                                                    <Grid x:Name="DropDown" 
                SnapsToDevicePixels="True" 
                MinWidth="{TemplateBinding ActualWidth}" 
                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                        <Border x:Name="DropDownBorder" 
                      Background="#252526" 
                      BorderBrush="#3F3F46" 
                      BorderThickness="1" 
                      CornerRadius="4" 
                      Margin="0,2,0,0"/>
                                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </ComboBox.Template>

                                    <!-- Style màu cho các Item bên trong khi xổ danh sách -->
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="#252526"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#007ACC"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#3E3E42"/>
                                                    <Setter Property="Foreground" Value="#9CDCFE"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>

                                    <!-- Các Item con -->
                                    <ComboBoxItem Content="Hôm nay"/>
                                    <ComboBoxItem Content="7 ngày trở lại"/>
                                    <ComboBoxItem Content="30 ngày trở lại"/>
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 2. LIST PO (DATAGRID) -->
                <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="12" BorderBrush="#2D2D30" BorderThickness="1" Margin="0,0,105,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER: Tiêu đề bên trái - ComboBox bên phải -->
                        <Grid Grid.Row="0" Margin="4,4,4,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Tiêu đề -->
                            <TextBlock Grid.Column="0" Text="📋 DANH SÁCH PO (LIST PO)" 
                       FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" 
                       VerticalAlignment="Center"/>

                            
                        </Grid>
                        <!-- Bảng Dữ Liệu Chính -->
                        <DataGrid Grid.Row="1" x:Name="dgListPO" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="150"/>
                                <DataGridTextColumn Header="PO Number" Binding="{Binding PONumber}" Width="110"/>
                                <DataGridTextColumn Header="CUSTNO" Binding="{Binding Custno}" Width="130"/>
                                <DataGridTextColumn Header="Ship To" Binding="{Binding ShipTo}" Width="100"/>
                                <DataGridTextColumn Header="Ship By" Binding="{Binding ShipBy}" Width="100"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Roname}" Width="70"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="65"/>
                                <DataGridTextColumn Header="Export Date" Binding="{Binding ExportDate}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= RIGHT PANEL (CHECK AREA) ================= -->
            <Border Background="#252526" CornerRadius="8" Padding="16" Grid.ColumnSpan="2" Margin="2,0,0,0" Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="166*"/>
                        <RowDefinition Height="435*"/>
                    </Grid.RowDefinitions>

                    <!-- Thanh tiêu đề kèm Chú thích trạng thái -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <!-- Cột trái: Tiêu đề -->
                            <ColumnDefinition Width="*"/>
                            <!-- Cột phải: Chú thích (Legend) -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tiêu đề bên trái -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="⚡ QUẢN LÝ BÀN CHECK (CHECK)" FontSize="14" FontWeight="Bold" Foreground="#007ACC"/>
                            <TextBlock Text="Trạng thái làm việc theo từng bàn" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Chú thích bên phải -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Chú thích 1: Checking (Màu vàng) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Border Width="15" Height="15" CornerRadius="12" Background="#E2A03F" Margin="0,0,6,0"/>
                                <TextBlock Text="Checking" FontSize="15" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Chú thích 2: Bình thường / Rảnh -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="15" Height="15" CornerRadius="12" Background="#5E5E5E" Margin="0,0,6,0"/>
                                <TextBlock Text="WIP" FontSize="15" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                            </StackPanel>

                        </StackPanel>
                    </Grid>

                    <!-- Bảng trạng thái Bàn Check -->
                    <DataGrid x:Name="dgCheckStatus" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,51,0,0" Grid.RowSpan="3">
                        <DataGrid.Columns>

                            <!-- Cột 1: Mã PO -->
                            <DataGridTextColumn Header="Mã PO" Binding="{Binding PONumber}" Width="130"/>

                            <!-- Cột 2: Số bàn (Nổi bật) -->
                            <DataGridTemplateColumn Header="Số bàn" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Badge bo góc nổi bật -->
                                        <Border Background="#1E3A8A" 
                    CornerRadius="4" 
                    Padding="6,3" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Index}" 
                           Foreground="#A7E7FF" 
                           FontWeight="Bold" 
                           FontSize="13" 
                           HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột 2: Loại (PSTX / Typename) -->
                            <DataGridTextColumn Header="Loại PO" Binding="{Binding Roname}" Width="80"/>

                            <!-- Cột 3: Số lượng Inspec / Trạng thái WiP (Badge Màu) -->
                            <DataGridTemplateColumn Header="Số Inspec (WiP)" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#5E5E5E"/>
                                                    <Style.Triggers>
                                                        <!-- Thay đổi màu dựa vào thuộc tính NumInspec -->
                                                        <DataTrigger Binding="{Binding Status}" Value="Normal">
                                                            <Setter Property="Background" Value="#5E5E5E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Checking">
                                                            <Setter Property="Background" Value="#E2A03F"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rảnh">
                                                            <Setter Property="Background" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <!-- Hiển thị nội dung NumInspec -->
                                            <TextBlock Text="{Binding NumInspec}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột 4: Thời gian Lưu -->
                            <DataGridTextColumn Header="Thời Gian Lưu" Binding="{Binding SavedAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" Background="#252526" CornerRadius="6" Padding="12,8" Margin="0,12,0,0" Grid.ColumnSpan="3">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0"/>
                    <TextBlock Text="Hệ thống kết nối thành công" Foreground="#AAAAAA" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Tổng số PO: " Foreground="#AAAAAA" FontSize="12"/>
                    <TextBlock Text="128" Foreground="#007ACC" FontWeight="Bold" FontSize="12" Margin="0,0,16,0"/>
                    <TextBlock Text="Menu Options" Foreground="#888888" FontSize="12" TextDecorations="Underline" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>